# Copier ce fichier en ".env" et adapter les valeurs avant de lancer le projet.

DJANGO_SECRET_KEY=change-moi-avec-une-cle-secrete-generee
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Pas de valeur par défaut côté backend (config/settings.py) : si absent ou
# vide, l'API rejette TOUTES les requêtes venant d'un navigateur (y compris
# la connexion), avec une erreur CORS invisible dans l'UI. Domaine(s) exact(s)
# depuis lesquels le frontend est servi, séparés par des virgules, ex. :
# CORS_ALLOWED_ORIGINS=https://medicgest.exemple.fr
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgres://postgres:postgres@db:5432/gestion_medicaments

# Gravée dans le build du frontend (Vite), pas relue au démarrage du
# conteneur : URL de l'API telle que joignable depuis le NAVIGATEUR du
# visiteur (pas depuis l'intérieur de Docker). Si absente, le frontend
# déployé retombe sur http://localhost:8000/api/v1 et échoue à contacter
# l'API — la connexion échoue silencieusement (erreur réseau/CORS affichée
# comme une simple erreur de chargement, jamais comme un mot de passe
# incorrect depuis ce correctif). Modifier cette valeur nécessite un rebuild
# du service frontend (Force Recreate), pas un simple Redeploy.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Envoi des e-mails (rappels de prise, alertes de stock). Par défaut,
# absent = backend "console" : l'e-mail est écrit dans les logs du
# conteneur backend, jamais réellement envoyé (comportement de dev).
# Pour un envoi réel, décommenter et régler les lignes ci-dessous avec
# n'importe quel fournisseur SMTP (hébergeur, Gmail avec un mot de passe
# d'application, SendGrid, Mailgun, Brevo...) puis Redeploy du backend
# (bind-mounté, pas de rebuild nécessaire).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.fr
# EMAIL_PORT=587
# EMAIL_HOST_USER=compte@exemple.fr
# EMAIL_HOST_PASSWORD=mot-de-passe-ou-cle-api
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@exemple.fr
